# Copy to .env (never committed) and fill in. Dummy values only here.
# The same variable names are used locally and on the server.

# Bot token from https://discord.com/developers/applications (Bot tab)
DISCORD_TOKEN=change-me

# Optional: register slash commands on this server only (instant, handy in dev).
# Leave empty to register them globally.
DISCORD_GUILD_ID=

# Shared secret between the bot and Lavalink (any long random string)
LAVALINK_PASSWORD=change-me

# Only used by `npm run dev` outside Docker (see README)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
