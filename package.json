{
  "name": "music-bot",
  "version": "0.1.0",
  "description": "Discord music bot powered by discord.js and Lavalink",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "lavalink-client": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
